{
  "openapi": "3.1.0",
  "info": {
    "title": "Distributed-Buy API",
    "description": "API publica do sistema de e-commerce distribuido. Internamente, cada pedido e convertido em chamadas gRPC (Protocol Buffers) protegidas por mTLS e JWT.",
