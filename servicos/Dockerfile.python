# Imagem comum aos servicos Python. O argumento SERVICO escolhe a pasta.
FROM python:3.12-slim
WORKDIR /app
COPY servicos/requisitos.txt .
RUN pip install --no-cache-dir -r requisitos.txt
COPY proto/ /app/proto/
RUN mkdir -p /app/gen && python -m grpc_tools.protoc -I /app/proto --python_out=/app/gen --grpc_python_out=/app/gen /app/proto/loja.proto
COPY servicos/comum/ /app/comum/
# O argumento so aparece aqui, para as camadas de cima serem partilhadas por todos os servicos.
ARG SERVICO
COPY servicos/${SERVICO}/ /app/
ENV PYTHONUNBUFFERED=1
CMD ["python", "main.py"]
